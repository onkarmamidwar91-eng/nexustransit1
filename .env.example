# ==== NexusTransit backend environment ====

# App
APP_NAME=NexusTransit
ENVIRONMENT=development
DEBUG=true

# Database
# Default: SQLite fallback (no setup needed) — good for MVP/demo.
DATABASE_URL=sqlite:///./nexustransit.db
# For PostgreSQL + PostGIS instead, uncomment and adjust:
# DATABASE_URL=postgresql://nexustransit:nexustransit@localhost:5432/nexustransit

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — comma-separated list. Add your deployed Vercel URL here in production,
# e.g. http://localhost:5173,https://nexustransit.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_UPLOAD_SIZE_MB=100

# AI
DEMO_MODE=true
DETECTION_CONFIDENCE_THRESHOLD=0.4

# Redis (prepared for later; not required for MVP synchronous mode)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# Frontend (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
